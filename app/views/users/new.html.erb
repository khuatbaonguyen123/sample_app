<% provide :title, t(".title") %>

<h1><%= t(".title") %></h1>
<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <%= form_for @user, url: signup_path, data: {turbo: false} do |f| %>
      <%= render "shared/error_messages" %>

      <%= f.label :name, t(".name") %>
      <%= f.text_field :name %>

      <%= f.label :email, t(".email") %>
      <%= f.email_field :email %>

      <%= f.label :birthday, t(".birthday") %>
      <%= f.date_field :birthday, class: "form-control", max: Date.today %>

      <%= f.label :gender, t(".gender") %>
      <%= f.select :gender, gender_options_for_select, {}, class: "form-control" %>

      <%= f.label :password, t(".password") %>
      <%= f.password_field :password %>

      <%= f.label :password_confirmation, t(".password_confirmation") %>
      <%= f.password_field :password_confirmation %>

      <%= f.submit t(".submit"), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
